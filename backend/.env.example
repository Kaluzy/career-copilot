# ── Supabase ─────────────────────────────────────────────────
# Use a NEW Supabase project for Career Copilot (recommended)
# OR use your existing IT Command Center project with new tables
# Get these from: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=eyJhb...   # service_role key (NOT anon key — backend needs full access)
SUPABASE_ANON_KEY=eyJhb...      # anon key (used by frontend)

# ── AI / Claude ────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────
APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
